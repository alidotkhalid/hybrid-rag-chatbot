# Copy to .env and fill in. Every variable is optional except the API key —
# without one the service runs in retrieval-only mode (RAG_LLM_PROVIDER=echo),
# which is genuinely useful for demoing the retrieval half.

# ── Generation ───────────────────────────────────────────────────────────────
# groq | gemini | openai | echo
RAG_LLM_PROVIDER=groq

# Groq  → https://console.groq.com/keys        (free tier, no card required)
# Gemini→ https://aistudio.google.com/apikey   (free tier)
RAG_LLM_API_KEY=

# groq:   openai/gpt-oss-120b | openai/gpt-oss-20b | groq/compound
#         (run `python scripts/list_models.py` to list what YOUR key can call —
#          Groq's docs list Enterprise-only models a free key cannot use)
# gemini: gemini-2.0-flash
# openai: gpt-4o-mini
RAG_LLM_MODEL=openai/gpt-oss-120b

# Only for RAG_LLM_PROVIDER=openai pointed at something else:
#   Ollama    → http://localhost:11434/v1
#   OpenRouter→ https://openrouter.ai/api/v1
# RAG_LLM_BASE_URL=

RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=900

# ── Retrieval (defaults are tuned; see evaluation/README.md before changing) ──
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_CHUNK_TARGET_TOKENS=320
# RAG_CHUNK_OVERLAP_TOKENS=64
# RAG_DENSE_TOP_K=30
# RAG_SPARSE_TOP_K=30
# RAG_RRF_K=60
# RAG_FINAL_TOP_K=6

# Groundedness gate. Raise toward 0 to refuse more readily, lower to answer
# more readily. Measure the effect with:
#   python -m evaluation.run_eval
# RAG_MIN_RERANK_SCORE=-6.0

# ── Service ──────────────────────────────────────────────────────────────────
# RAG_PORT=7860
# RAG_MAX_UPLOAD_MB=20
# RAG_SESSION_TTL_MINUTES=60
